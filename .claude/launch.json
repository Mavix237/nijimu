{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "dev-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "--port",
        "5181"
      ],
      "port": 5181
    },
    {
      "name": "dev-alt2",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "--port",
        "5182",
        "--strictPort"
      ],
      "port": 5182
    },
    {
      "name": "dev-auto",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "pnpm exec vite --port ${PORT:-5183} --strictPort"
      ],
      "port": 5183,
      "autoPort": true
    }
  ]
}
