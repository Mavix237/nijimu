# Copy to .env.local (gitignored) and fill in.
# No VITE_ prefix — these stay server-side and never reach the browser bundle.

# Speech-to-text for the recording screen (/api/transcribe)
OPENAI_API_KEY=

# Optional: override the transcription model (default gpt-4o-transcribe)
# TRANSCRIBE_MODEL=whisper-1

# Rewriting the transcript as prose on the transcript screen (/api/polish)
ANTHROPIC_API_KEY=
# Optional: override the polish model (default claude-opus-4-8)
# POLISH_MODEL=claude-haiku-4-5

# Whole-transcript shape assessment (reuses the transcription OPENAI_API_KEY above)
# ASSESS_MODEL=gpt-4.1-mini

# Save to phone (/api/share): the memory's card is kept for about a day so a phone can open it
# from a QR code. Create a Vercel Blob store set to Private and connect it to the project; Vercel
# then sets BLOB_READ_WRITE_TOKEN. Without it the dev server keeps cards in memory (lost on restart)
# and production answers 503. SHARE_BLOB_ACCESS=public only if the store was made public.
# BLOB_READ_WRITE_TOKEN=
# SHARE_BLOB_ACCESS=private
# The daily sweep (/api/share-sweep, vercel.json "crons") only runs with this set on Vercel:
# CRON_SECRET=
